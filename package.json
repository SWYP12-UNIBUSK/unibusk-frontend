    "next-themes": "^0.4.6",
    "react": "19.0.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.0.3",
    "react-hook-form": "^7.70.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.4",
    "zustand": "^5.0.10"
